# direnv: per-project environment, auto-loaded when you cd into the repo.
# Run `direnv allow` once after cloning (and after any edit to this file).
#
# Pinned Ansible collections install (gitignored) under bootstrap/collections:
#   ansible-galaxy collection install -r bootstrap/requirements.yml -p bootstrap/collections
# Exporting the path here lets every tool — ansible-playbook, molecule, and
# ansible-lint — resolve the same pinned set with no per-tool configuration.
# (ansible-lint in particular ignores ansible.cfg's collections_path and only
# honors this variable.)
export ANSIBLE_COLLECTIONS_PATH="${PWD}/bootstrap/collections"

# Activate the project virtualenv so python, ansible, molecule, ansible-lint,
# and pre-commit all resolve from bootstrap/.venv without a manual `source`.
# PATH_add is a direnv builtin: it prepends cleanly and direnv reverses it on
# `cd` out, so there is no race with a hand-run `activate`.
export VIRTUAL_ENV="${PWD}/bootstrap/.venv"
PATH_add "${VIRTUAL_ENV}/bin"
