# .editorconfig — editor formatting baseline.
# https://editorconfig.org — natively supported by VS Code, JetBrains,
# vim/neovim. Constrains indent style; does not disable formatters.
# Prettier (and similar) ignores via .prettierignore alongside this file.

root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 2

# Markdown — trailing two-spaces is a hard linebreak, don't strip it.
[*.md]
trim_trailing_whitespace = false

# Python — PEP 8.
[*.py]
indent_size = 4

# Makefile — must use tabs.
[Makefile]
indent_style = tab
